{
  "version": "1.0.0",
  "tasks": {
    "build": "deno run --allow-read --allow-write --allow-env src/build.ts",
    "serve": "deno run --allow-net --allow-read --allow-env src/server.ts",
    "dev": "deno run --allow-read --allow-write --allow-env src/build.ts && deno task serve"
  },
  "imports": {
    "@deno/gfm": "jsr:@deno/gfm@^0.10.0",
    "@std/http": "jsr:@std/http@^1.0.0"
  }
}
